/* CSS Variables */
:root {
    --color-progressbar-background: rgba(16, 16, 16, 0.75);
    --color-progressbar-border-color: rgba(0, 0, 0, 0);
    --color-progressbar-fill: rgba(145, 213, 97, 0.75);
    --color-progressbar-text: rgb(255, 255, 255);
    --color-progressbar-text-low: rgb(255, 0, 0);
    --color-progressbar-ammo-blue: rgba(19, 181, 231, 0.75);
}

/* Root Container */
#hud-root {
    position: absolute;
    width: 100%;
    height: 100%;
}

/* Health Info Container */
#health-info-container {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: auto;
    background-color: rgba(0, 0, 0, 0.0);
    padding: 15px;
    border-radius: 5px;
    width: 320px;
}

/* Progress Bars */
#player-health-bar {
    width: 100%;
    height: 30px;
    min-height: 30px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    flex-shrink: 0;
    justify-content: center;
}

#player-stamina-bar {
    width: 100%;
    height: 30px;
    min-height: 30px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    flex-shrink: 0;
    justify-content: center;
}

/* Round + Bonus timers (top-middle, side by side, centered as a pair) */
#timers-container {
    position: absolute;
    top: 20px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
}

.hud-timer {
    width: 150px;
    margin-left: 6px;
    margin-right: 6px;
    border-radius: 6px;
    border-width: 2px;
    padding: 4px 8px 6px 8px;
    align-items: center;
}

.hud-timer-caption {
    font-size: 13px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.hud-timer-value {
    font-size: 32px;
    -unity-text-align: middle-center;
}

/* Round timer: cool blue */
#round-timer-container {
    background-color: rgba(18, 52, 120, 0.85);
    border-color: rgb(110, 190, 255);
}

#round-timer-caption {
    color: rgb(170, 220, 255);
}

#round-timer-label {
    color: rgb(255, 255, 255);
}

/* Bonus timer: warm gold */
#bonus-timer-container {
    background-color: rgba(120, 70, 0, 0.85);
    border-color: rgb(255, 200, 60);
}

#bonus-timer-caption {
    color: rgb(255, 215, 110);
}

#bonus-timer-label {
    color: rgb(255, 236, 160);
}

.hud-timer--expired {
    opacity: 0.4;
}

/* Round-over / finished banner (upper middle) */
#round-banner {
    position: absolute;
    top: 22%;
    left: 0;
    right: 0;
    align-items: center;
}

#round-banner-title {
    font-size: 54px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    text-shadow: 2px 2px 4px rgb(0, 0, 0);
}

#round-banner-subtitle {
    font-size: 22px;
    color: rgb(235, 235, 235);
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 3px rgb(0, 0, 0);
    margin-top: 6px;
}

.round-banner--good #round-banner-title {
    color: rgb(140, 230, 110);
}

.round-banner--bad #round-banner-title {
    color: rgb(255, 110, 100);
}

/* Scoreboard (left-middle) */
#scoreboard-container {
    position: absolute;
    top: 50%;
    left: 20px;
    width: 240px;
    margin-top: -120px;
    max-height: 340px;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 5px;
    padding: 10px;
}

.scoreboard-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 4px 6px;
}

.scoreboard-name {
    color: rgb(255, 255, 255);
    font-size: 16px;
}

.scoreboard-score {
    color: rgb(145, 213, 97);
    font-size: 16px;
}

/* Team rows at the top of the scoreboard */
.scoreboard-team-row {
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    margin-bottom: 2px;
}

.scoreboard-total-score {
    color: rgb(255, 215, 90);
}

.scoreboard-target-score {
    color: rgb(170, 220, 255);
}

.scoreboard-target-met {
    color: rgb(140, 230, 110);
}

.scoreboard-divider {
    height: 2px;
    background-color: rgba(255, 255, 255, 0.25);
    margin: 4px 2px 4px 2px;
}

.scoreboard-name--finished {
    color: rgb(150, 150, 150);
}

/* Notification Styles */
.notification-container {
    position: absolute;
    top: 20px;
    right: 20px;
    flex-direction: column;
    min-width: 200px;
    max-width: 350px;
    max-height: 200px;
}

.notification-item {
    flex-direction: column;
    background-color: rgba(22, 22, 24, 0.9);
    border-radius: 8px;
    padding: 8px 12px;
    margin-bottom: 6px;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.notification-item Label {
    color: rgb(229, 229, 229);
    font-size: 11px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.notification-fade-out {
    opacity: 0;
}

/* Challenge Betting Overlay */
#challenge-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.75);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

#challenge-title-label {
    font-size: 30px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

#challenge-subtitle-label {
    font-size: 16px;
    color: rgb(210, 210, 210);
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

#challenge-timer-bar {
    width: 320px;
    height: 22px;
    min-height: 22px;
    margin-bottom: 20px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

#challenge-bet-buttons {
    flex-direction: column;
    align-items: center;
    width: 360px;
}

#challenge-bet-buttons Button {
    width: 100%;
    height: 40px;
    margin-bottom: 8px;
    font-size: 14px;
    white-space: normal;
}

#challenge-bet-status-label {
    font-size: 16px;
    color: rgb(145, 213, 97);
    margin-bottom: 10px;
}

#challenge-bet-announcements {
    flex-direction: column;
    align-items: center;
    max-width: 400px;
}

.challenge-bet-announcement {
    font-size: 13px;
    color: rgb(220, 220, 220);
    -unity-text-align: middle-center;
}

/* Message Overlay */
#message-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

#message-label {
    font-size: 28px;
    color: white;
    text-shadow: 1px 1px 2px rgb(0, 0, 0);
    margin-bottom: 12px;
}

#message-divider {
    width: 194px;
    height: 4px;
    background-color: white;
    margin-bottom: -10px;
    align-self: center;
}

#countdown-label {
    font-size: 150px;
    color: rgb(255, 255, 255);
    letter-spacing: -5px;
}
